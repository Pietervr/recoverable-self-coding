#!/bin/bash
#PBS -N t1_row6_parity
#PBS -P CSCI1913
#PBS -q serial
#PBS -l select=1:ncpus=3:mpiprocs=3:nodetype=haswell_reg
#PBS -l walltime=04:00:00
#PBS -o /mnt/lustre/users/pvanrooyen/t1_toolchain/jobs/row6_parity.out
#PBS -e /mnt/lustre/users/pvanrooyen/t1_toolchain/jobs/row6_parity.err
#PBS -m ae
#PBS -M pgwvanrooyen@sun.ac.za
# Ledger row 6 extended to Lengau (rsc_t1_simulation_design.md section 12): the three declared sens600 datasets re-run
# on three shared Haswell cores under the pinned cloud library set and the code of f7e69b1 (hash 625798e9e7f4), the
# compared quantities written to a CSV; the blinded comparison runs on the Mac. At most 12 core-hours of the 500-hour
# benchmark reserve. Submitted on the owner's go of 2 October 2026 ("yes, go with 1. and 2."):
#   qsub /mnt/lustre/users/pvanrooyen/t1_toolchain/jobs/row6_lengau_panel.pbs
ulimit -s unlimited
T=/mnt/lustre/users/pvanrooyen/t1_toolchain
cd $T/rsc/workspace_demo/t1_access
export NPROC=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
echo "host $(hostname)  $(grep -m1 'model name' /proc/cpuinfo)"
echo "code $(git rev-parse --short HEAD)  start $(date -u +%FT%TZ)"
$T/t1py -c 'import sys, jax, jaxlib, numpy, scipy, joblib; print("python", sys.version.split()[0], "jax", jax.__version__, "jaxlib", jaxlib.__version__, "numpy", numpy.__version__, "scipy", scipy.__version__, "joblib", joblib.__version__)'
time $T/t1py $T/jobs/row6_lengau_panel.py $T/jobs/row6_lengau_rows.csv
echo "end $(date -u +%FT%TZ)"
