+def ec2_state(w, e2q3="dispositioned", q2="dispositioned", age=60, mac_age=None, gen=109, lengau=True, mac=True, launched=False):
+    """The EC2 bookkeeping BOTH sides see, CONSTRUCTED from the frozen sealed g105 inventory (the candidate fixture): E2Q3/1 and
+    qual-Q2/1 with the given ingestion, owners recomputed, sealed at `now - age` as generation `gen`. Mac: runs/<run>/attempts.json,
+    the authority state and runs/inventory/latest.json (+ its archive). Lengau: the installed ec2/authority/inventory.json and an
+    EC2 register with no published coordinate."""
+    tmpl = json.loads(open(os.path.join(LIVE_T1, "chpc/candidate_v20_handback/fixtures/inventory_g105.json"), "rb").read())
+    need(sha(os.path.join(LIVE_T1, "chpc/candidate_v20_handback/fixtures/inventory_g105.json")) == FIX_INV_SHA, "the frozen g105 fixture moved")
+    inv = {k: v for k, v in tmpl.items() if k != "sha256"}
+    inv["attempts"]["qual-E2Q3/1"]["ingestion"] = e2q3; inv["attempts"]["qual-Q2/1"]["ingestion"] = q2
+    if launched:
+        inv["attempts"]["qual-E2Q3/1"]["state"] = "launched"
+    owners = {}
+    for k, a in sorted(inv["attempts"].items()):
+        if a["class"] in ("production", "qualification") and a["state"] != "rejected" and a["ingestion"] == "pending":
+            for c in a["coordinates"]:
+                owners["%d/%d" % tuple(c)] = [k, a["sequence"]]
+    inv["owners"] = dict(sorted(owners.items())); inv["generation"] = gen
+    now = time.time()
+
+    def sealed(a):
+        return seal(dict(inv, at=now - a))
+    if lengau:
+        write(os.path.join(w.GS, "ec2/authority/inventory.json"), json.dumps(sealed(age), indent=1, sort_keys=True))
+        write(os.path.join(w.GS, "ec2/register.json"), json.dumps({"schema": "row19-ec2-register-2", "authority_generation": gen,
+                                                                   "fence": {}, "attempts": {}}, indent=1))
+    if mac:
+        runs = os.path.join(w.t1, "aws_ec2/runs"); leds = {}
+        for k, a in inv["attempts"].items():
+            leds.setdefault(a["run"], []).append(dict(attempt=a["attempt"], attempt_id=a["attempt_id"], sequence=a["sequence"],
+                                                     state=a["state"], ingestion=a["ingestion"], coordinates=a["coordinates"],
+                                                     contract=a["contract"]))
+        for run, atts in leds.items():
+            write(os.path.join(runs, run, "attempts.json"), json.dumps({"run": run, "attempts": atts}, indent=1))
+        write(os.path.join(runs, ".authority_state.json"), json.dumps({"generation": gen, "next_sequence": 13}))
+        mi = json.dumps(sealed(age if mac_age is None else mac_age), indent=1, sort_keys=True)
+        write(os.path.join(runs, "inventory", "latest.json"), mi); write(os.path.join(runs, "inventory", "inventory_g%d.json" % gen), mi)
+
