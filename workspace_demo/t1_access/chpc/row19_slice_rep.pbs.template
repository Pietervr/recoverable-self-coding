#!/bin/bash
#PBS -N t1_row19_slice_rep__REP__
#PBS -P CSCI1913
#PBS -q seriallong
#PBS -l select=1:ncpus=1:mpiprocs=1:mem=8gb:nodetype=haswell_reg
#PBS -l walltime=144:00:00
#PBS -o /mnt/lustre/users/pvanrooyen/t1_toolchain/jobs/row19_slice_rep__REP__.__ATTEMPT__.out
#PBS -e /mnt/lustre/users/pvanrooyen/t1_toolchain/jobs/row19_slice_rep__REP__.__ATTEMPT__.err
#PBS -m ae
#PBS -M pgwvanrooyen@sun.ac.za
# Ledger row 19, stage 1, route A: ONE dataset of the qualification slice (rep __REP__) on one shared Haswell core under
# the section 7.4 start policy, declared in chpc/row19_slice_manifest.json. The runner stops dispatching 30 minutes before
# the walltime, flushes and exits 75; the next attempt of this file resumes from the fsynced checkpoint. __TOKEN__ is the
# campaign reservation made BEFORE this qsub (chpc/row19_ledger.py reserve --kind main --rep __REP__). Submitted ONLY
# after Codex's review of the launch specification and the owner's go on row 19's slice, under the manifest's budget.
ulimit -s unlimited
T=/mnt/lustre/users/pvanrooyen/t1_toolchain
cd $T/rsc_slice/workspace_demo/t1_access
export NPROC=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 PYTHONUNBUFFERED=1
echo "host $(hostname)  $(grep -m1 'model name' /proc/cpuinfo)"
echo "code $(git rev-parse --short HEAD)  start $(date -u +%FT%TZ)  job $PBS_JOBID"
mkdir -p $T/row19_slice
# PROCESS RECYCLING (5 Oct 2026, after four of four long processes died after 41-57 h with an LLVM "Cannot allocate memory"
# while resident memory was 2.6 of 8 GB - most likely the per-process memory-mapping limit, vm.max_map_count 65,530, exhausted
# by repeated XLA compilation): the unchanged runner is called with --segment 1, so each process computes at most ONE new
# resample and exits 75; the loop starts a FRESH process for the next one. The runner resumes from its fsynced checkpoint and
# its cached original fit on every call, under the same reservation and job id. The loop stops when a call returns anything
# but 75, when a call adds no new record (a stop request, the control target or the deadline), or when less than RECYCLE_SAFE_S
# of walltime is left for another resample (so no resample is cut by the PBS walltime).
# LIFECYCLE AND LOGGER (Codex RSC 0be5547, 5 Oct): every call writes "recycle: job <id> call <n> start <time>" before the runner
# starts, so the watch can tell a process that ended between calls from a job that ended; the job-final line keeps the
# original grammar "exit <rc> tee <tee> job <id> end <time>" (the call count is on the line before it). The FIRST failure of
# the live-log tee or of the per-call capture ends the loop and stays in the job-final line: a later call can never
# overwrite a known incomplete stream. Every lifecycle marker goes through mark(): its tee status is checked at once and kept
# in the same sticky field; a failed call-start marker removes the capture file and stops BEFORE the runner is dispatched
# (Codex RSC 71dee38).
JOB_START=$(date +%s); JOB_END=$((JOB_START + 518400)); RECYCLE_SAFE_S=86400
LOG=$T/row19_slice/live_rep__REP__.log
calls=0; rc=75; tee_rc=0
mark() { echo "$1" | tee -a $LOG; local r=${PIPESTATUS[1]:-1}; if [ "$r" != "0" ] && [ "$tee_rc" = "0" ]; then tee_rc=$r; fi; return $r; }
while :; do
  now=$(date +%s)
  if [ $((JOB_END - now)) -lt $RECYCLE_SAFE_S ]; then mark "recycle: $((JOB_END - now)) s left, below $RECYCLE_SAFE_S s for another resample; exit 75"; rc=75; break; fi
  CALL_OUT=$(mktemp) || { tee_rc=1; echo "LOGGER FAILURE: no capture file for call $((calls + 1))" | tee -a $LOG; break; }
  if ! mark "recycle: job $PBS_JOBID call $((calls + 1)) start $(date -u +%FT%TZ)"; then
    rm -f $CALL_OUT; if [ "$tee_rc" = "0" ]; then tee_rc=1; fi
    echo "LOGGER FAILURE: the call $((calls + 1)) start marker was not written (tee $tee_rc); nothing dispatched"; break
  fi
  calls=$((calls + 1))
  $T/t1py chpc/row19_slice.py --manifest chpc/row19_slice_manifest.json --rep __REP__ --walltime-s 518400 --root $T/row19_slice --campaign $T/row19_campaign --job-id $PBS_JOBID --reservation-token __TOKEN__ --kind main --segment 1 2>&1 | tee -a $LOG | tee $CALL_OUT
  ps=("${PIPESTATUS[@]}"); rc=${ps[0]}
  if [ "${ps[1]}" != "0" ]; then tee_rc=${ps[1]}; fi
  if [ "$tee_rc" = "0" ] && [ "${ps[2]}" != "0" ]; then tee_rc=${ps[2]}; fi
  new=$(grep -o "new [0-9]*," $CALL_OUT | tail -1 | tr -dc '0-9'); rm -f $CALL_OUT
  if [ "$tee_rc" != "0" ]; then echo "LOGGER FAILURE: call $calls live-log tee ${ps[1]} capture tee ${ps[2]}; the loop stops" | tee -a $LOG; break; fi
  if [ "$rc" != "75" ]; then break; fi
  if [ -z "$new" ] || [ "$new" = "0" ]; then mark "recycle: call $calls added no record; exit 75"; break; fi
done

mark "recycle: job $PBS_JOBID calls $calls"
echo "exit $rc tee $tee_rc job $PBS_JOBID end $(date -u +%FT%TZ)" | tee -a $LOG
w=$?; if [ $w -ne 0 ] || [ "$tee_rc" != "0" ]; then echo "LOGGER FAILURE: tee $tee_rc, terminal witness write rc $w"; fi
exit $rc
