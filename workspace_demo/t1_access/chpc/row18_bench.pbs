#!/bin/bash
#PBS -N t1_row18_bench
#PBS -P CSCI1913
#PBS -q serial
#PBS -l select=1:ncpus=1:mpiprocs=1:nodetype=haswell_reg
#PBS -l walltime=03:00:00
#PBS -o /mnt/lustre/users/pvanrooyen/t1_toolchain/jobs/row18_bench.out
#PBS -e /mnt/lustre/users/pvanrooyen/t1_toolchain/jobs/row18_bench.err
#PBS -m ae
#PBS -M pgwvanrooyen@sun.ac.za
# Ledger row 18, stage 1 (rsc_t1_simulation_design.md sections 11c and 12): per-member fit time and one full
# layer of the section-8 pipeline at D = 4 on ONE Haswell core - the members and shape of the 22 September Mac
# measurement (section 11b) - on the code of f7e69b1, the last commit touching models/analyze/simulate/bench
# before the row-4 amendment. One core on the shared serial queue: at most 3 core-hours against the 500 cap.
# Submit only on the owner's go:   qsub /mnt/lustre/users/pvanrooyen/t1_toolchain/jobs/row18_bench.pbs
ulimit -s unlimited
T=/mnt/lustre/users/pvanrooyen/t1_toolchain
cd $T/rsc/workspace_demo/t1_access
export NPROC=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
echo "host $(hostname)  $(grep -m1 'model name' /proc/cpuinfo)"
echo "code $(git rev-parse --short HEAD)  start $(date -u +%FT%TZ)"
$T/t1py -c 'import sys, jax, jaxlib, numpy, scipy, joblib; print("python", sys.version.split()[0], "jax", jax.__version__, "jaxlib", jaxlib.__version__, "numpy", numpy.__version__, "scipy", scipy.__version__, "joblib", joblib.__version__)'
time $T/t1py bench.py --D 4 --layer
echo "end $(date -u +%FT%TZ)"
