#!/bin/bash
#PBS -N t1_row19_ctl___MODE__
#PBS -P CSCI1913
#PBS -q serial
#PBS -l select=1:ncpus=1:mpiprocs=1:mem=8gb:nodetype=haswell_reg
#PBS -l walltime=__WALLTIME__
#PBS -o /mnt/lustre/users/pvanrooyen/t1_toolchain/jobs/row19_ctl___MODE__.out
#PBS -e /mnt/lustre/users/pvanrooyen/t1_toolchain/jobs/row19_ctl___MODE__.err
#PBS -m ae
#PBS -M pgwvanrooyen@sun.ac.za
# Ledger row 19, stage 1: the RECOVERY CONTROL on dataset rep 0's exact-index subchain (resamples 0..19 under the
# unchanged B = 200 identity), declared in chpc/row19_slice_manifest.json 'control':
#   C1  normal     : --until 20 in its own root (row19_slice_ctl_normal), no interruption, 48 h walltime (__KIND__ c1, __KILL_FLAG__ empty)
#   C2  interrupted: --until 20 --pbs-kill-control in a second root (row19_slice_ctl_interrupted) under walltime W_int
#                    (__WALLTIME__ = C1's measured original + 3 x the median of its first three resamples, rounded up to the
#                    minute; reserved and submitted only after C1 recorded them): no cooperative deadline, PBS kills it; the
#                    fsynced checkpoint holds the completed resamples; the operator writes c2_interruption.json from qstat -xf
#                    and the checkpoint (__KIND__ c2)
#   C3  resume     : --until 20 in C2's root, 48 h walltime: resumes to the fixed target 0..19 (strict restore, no re-fit
#                    of a completed resample, the original run from its validated cache) (__KIND__ c3)
# __TOKEN__ is each run's campaign reservation, made BEFORE its qsub (chpc/row19_ledger.py reserve --kind c1|c2|c3 --rep 0).
# Then C1's and C3's completed outputs are compared field by field on the Mac (chpc/row19_control_compare.py).
ulimit -s unlimited
T=/mnt/lustre/users/pvanrooyen/t1_toolchain
cd $T/rsc_slice/workspace_demo/t1_access
export NPROC=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 PYTHONUNBUFFERED=1
echo "host $(hostname)  $(grep -m1 'model name' /proc/cpuinfo)"
echo "code $(git rev-parse --short HEAD)  start $(date -u +%FT%TZ)  job $PBS_JOBID  mode __MODE__"
mkdir -p $T/__ROOT__
$T/t1py chpc/row19_slice.py --manifest chpc/row19_slice_manifest.json --rep 0 --until 20 __KILL_FLAG__ --walltime-s __WALLTIME_S__ --root $T/__ROOT__ --campaign $T/row19_campaign --job-id $PBS_JOBID --reservation-token __TOKEN__ --kind __KIND__ 2>&1 | tee -a $T/__ROOT__/live_ctl___MODE__.log
ps=("${PIPESTATUS[@]}"); rc=${ps[0]}; tee_rc=${ps[1]}

echo "exit $rc tee $tee_rc job $PBS_JOBID end $(date -u +%FT%TZ)" | tee -a $T/__ROOT__/live_ctl___MODE__.log
w=$?; if [ $w -ne 0 ] || [ "$tee_rc" != "0" ]; then echo "LOGGER FAILURE: tee $tee_rc, terminal witness write rc $w"; fi
exit $rc
