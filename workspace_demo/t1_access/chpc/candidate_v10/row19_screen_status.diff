+def ec2_reconcile(man, role, units, root, assigned, alarms):
+    """REVISION 10 (Codex f3dd3d7 contract 5): EC2 production attempts are a second producer kind, read from the ingestion
+    register root/ec2/register.json (written only by chpc/row19_ec2_ingest.py). Each attempt's coordinates join `assigned`
+    (so its records are not foreign); an 'ingesting' attempt may still lack records; an 'ingested' one must have, for every
+    coordinate it published, a valid record and a valid timing naming exactly this attempt and slot, its status copied under
+    root/ec2/status/, and every coordinate inside the provider partition. A coordinate claimed by two attempts, an unknown
+    register state, or EC2 evidence while no partition is in force, is an alarm. Returns the per-attempt summary for the
+    receipt's `ec2` field (USD settlement as recorded at ingestion; CHPC core-hours are never mixed in)."""
+    reg_p = os.path.join(root, "ec2", "register.json")
+    if not os.path.exists(reg_p):
+        return {}
+    try:
+        reg = json.load(open(reg_p))
+    except Exception as e:
+        alarms.append(f"the EC2 register is unreadable ({e})"); return {}
+    try:
+        import row19_screen_admit as _SA, row19_partition as _RP
+        part = _SA.partition(man, MANIFEST_PATH)
+    except Exception as e:
+        alarms.append(f"EC2 register present but the provider partition cannot be trusted ({e})"); part = None
+    if part is None:
+        alarms.append("EC2 register present but no provider partition is in force")
+    out, owner = {}, {}
+    for aid, e in sorted((reg.get("attempts") or {}).items()):
+        st = e.get("state"); coords = e.get("coordinates") or {}
+        out[aid] = dict(state=st, epoch=e.get("epoch"), coordinates=len(coords), sentinels_equal=len(e.get("sentinels_equal") or []),
+                        failed=sum(1 for c in coords.values() if c.get("failed")), charged_usd=e.get("charged_usd"),
+                        plan_sha256=e.get("plan_sha256"))
+        if st not in ("ingesting", "ingested"):
+            alarms.append(f"EC2 attempt {aid}: unknown register state {st!r}"); continue
+        for key, ce in coords.items():
+            if key in owner:
+                alarms.append(f"EC2 unit {key}: claimed by attempts {owner[key]} and {aid}"); continue
+            owner[key] = aid; assigned.add(key)
+            r, i = (int(x) for x in key.split("/"))
+            if part is not None and not _RP.blocked(part, r, i):
+                alarms.append(f"EC2 unit {key} ({aid}): outside the provider partition")
+            if st != "ingested" or ce.get("preexisting"):
+                continue
+            v = units.get(key) or {}
+            if not (v.get("record") or {}).get("ok"):
+                alarms.append(f"EC2 unit {key} ({aid}): no valid record"); continue
+            if not (v.get("timing") or {}).get("ok"):
+                alarms.append(f"EC2 unit {key} ({aid}): no valid timing"); continue
+            if v["timing"].get("job") != aid or v["timing"].get("slot") != ce.get("slot"):
+                alarms.append(f"EC2 unit {key}: timing names {v['timing'].get('job')} slot {v['timing'].get('slot')}, not {aid} slot {ce.get('slot')}")
+            if not os.path.exists(os.path.join(root, "ec2", "status", f"{aid}.slot{ce.get('slot')}.json")):
+                alarms.append(f"EC2 unit {key} ({aid}): no worker status copied")
+    return out
+
