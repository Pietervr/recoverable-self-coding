+"""POST /api/capture — the T1 single-pass capture path (local patch, t1-capture-2).
+
+Contract: Recoverable-Self-Coding workspace_demo/t1_access/PREREGISTRATION_T1_model.md §4 (with the 15 Sept 2026
+draft amendments: native bfloat16, closed-set R3 with open-vocabulary ranks). Shipped as
+workspace_demo/patches/serve_capture.patch (this module plus a hook at the end of serve.py); the upstream clone is
+never vendored. Revision 2 answers the Codex record reviews/2026-09-15_r084_capture_endpoint_codex_record.md.
+
+One request is one trial:
+- explicit ``input_ids`` built by the caller's tokenizer code (no chat template, no special tokens added here);
+  longer than ``MAX_CAPTURE_TOKENS`` is rejected, never truncated;
+- a NEW ``StreamSession`` per request and ONE ``extend`` over all ids, batch 1;
+- ``capture_layers`` (default every layer): the post-layer, pre-final-norm residual ``acts[l]`` at
+  ``readout_positions``, returned as native-dtype bytes (bfloat16 carried bit for bit through a uint16 view);
+- the final position's logits: logsumexp (float32), for every requested id its logit and its open-vocabulary
+  rank (1 = argmax; ties ordered by ascending token id, the order of the returned top-k), the exact top-k
+  (id, logit) pairs, and the sha256 of the full native logits vector;
+- ``edits`` (optional) installed with ``StreamSession.set_edits``: each edit rewrites its layer's rows at its global
+  positions inside the same pass, before that layer's residual is captured and before downstream layers read it.
+  ``edits`` absent = the plain capture; ``edits: []`` = an empty edit list.
+
+Edit modes and doses:
+- ``steer``:      h + λ v_t,  v_t = J_lᵀ W_U[t] (``j_lens_vectors_lite``)
+- ``ablate``:     h − λ P_V h, V = {v_t : t ∈ ablate_token_ids}
+- ``swap_delta``: h + λ Δ,    Δ = patch_swap(h, α=1) − h for token_id → target_id
+- ``patch``:      the rows are replaced by the supplied vectors; no dose parameters are accepted
+The dose is λ = ``alpha``, OR (steer, swap_delta) a per-position written norm ``target_norms``, in which case
+``alpha`` must stay 1. **λ = 0 without target_norms is the zero dose: an exact identity** — no vector or delta is
+evaluated, the rows are returned unchanged and keep their native bits through the scatter (the sham of §11).
+With ``target_norms`` a position whose raw ||Δ|| < ``norm_floor_rel`` · ||h|| is left exactly unedited and flagged.
+Per edit and position the log carries ||h||, the requested norm, the raw ||Δ|| and the written ||Δh|| (after the
+cast back to the residual dtype), and the swap/ablate basis condition number. A basis with condition number above
+``COND_MAX``, nonfinite vectors or patch rows, and nonfinite residuals or logits are rejected with HTTP 422 and a
+reason; nothing is regularised silently.
+
+Provenance: at import this module hashes every loaded ``jlens_qwen`` source; at startup (after the model and lens
+load) it builds a manifest of content hashes — the resolved model snapshot's files, the resolved lens file, the
+loaded sources (re-hashed and compared with the import-time hashes), upstream HEAD with the tracked diff and the
+untracked sources, the mlx binaries and mlx_lm sources, runtime and machine, and the GDN dispatch flags. Its
+``identity_sha256`` excludes paths, times and process ids, so a fresh process from the same pinned files has the
+same identity. Captures are refused until the manifest exists, and whenever the loaded sources changed.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import base64
+import hashlib
+import json
+import math
+import os
+import platform
+import subprocess
+import sys
+import time
+from pathlib import Path
+from typing import Literal
+
+import mlx.core as mx
+import numpy as np
+from fastapi import APIRouter, HTTPException
+from pydantic import BaseModel, Field
+
+from jlens_qwen import interventions as _interventions  # bound here so its bytes are part of the import manifest
+
+PATCH_ID = "t1-capture-2"
+MAX_CAPTURE_TOKENS = 1024
+MAX_TOP_K = 4096
+MAX_LENS_VECTORS = 64 * 512
+COND_MAX = 1e6
+
+router = APIRouter()
+
+_DTYPE_NAMES = {"bfloat16": mx.bfloat16, "float16": mx.float16, "float32": mx.float32}
+_ITEMSIZE = {"bfloat16": 2, "float16": 2, "float32": 4}
+_hidden_dtype: mx.Dtype | None = None
+_MANIFEST: dict = {"ready": False}
+
+
+def sha256_file(path) -> str:
+    h = hashlib.sha256()
+    with open(path, "rb") as f:
+        for chunk in iter(lambda: f.read(1 << 24), b""):
+            h.update(chunk)
+    return h.hexdigest()
+
+
+def _loaded_jlens_sources() -> dict:
+    out = {}
+    for name, mod in sorted(sys.modules.items()):
+        if name == "jlens_qwen" or name.startswith("jlens_qwen."):
+            f = getattr(mod, "__file__", None)
+            if f and os.path.exists(f):
+                out[name] = sha256_file(f)
+    return out
+
+
+IMPORT_SOURCES = _loaded_jlens_sources()
+
+
+def _server():
+    """The loaded serve module (imported lazily: serve.py imports this module)."""
+    from jlens_qwen import serve
+
+    return serve
+
+
+def dtype_name(dt) -> str:
+    for name, d in _DTYPE_NAMES.items():
+        if d == dt:
+            return name
+    raise ValueError(f"unsupported dtype {dt}")
+
+
+def to_bytes(x: mx.array) -> bytes:
+    """Native-dtype little-endian bytes of ``x`` (bfloat16 via a uint16 view)."""
+    if x.dtype == mx.bfloat16:
+        a = np.array(mx.view(x, mx.uint16))
+    else:
+        a = np.array(x)
+    return np.ascontiguousarray(a).tobytes()
+
+
+def from_bytes(buf: bytes, name: str, shape: tuple[int, ...]) -> mx.array:
+    """Inverse of ``to_bytes``: bytes of dtype ``name`` reshaped to ``shape``."""
+    if name == "bfloat16":
+        return mx.view(mx.array(np.frombuffer(buf, dtype=np.uint16).reshape(shape)), mx.bfloat16)
+    npdt = {"float16": np.float16, "float32": np.float32}[name]
+    return mx.array(np.frombuffer(buf, dtype=npdt).reshape(shape))
+
+
+def ranks_of(logits: np.ndarray, ids: list[int]) -> tuple[np.ndarray, list[int]]:
+    """(the stable descending order, the 1-based open-vocabulary rank of each id). Ties: ascending token id."""
+    order = np.argsort(-logits, kind="stable")
+    rank = np.empty(order.size, dtype=np.int64)
+    rank[order] = np.arange(1, order.size + 1)
+    return order, [int(rank[t]) for t in ids]
+
+
+def basis_condition(V: np.ndarray) -> float:
+    """Condition number of the Gram matrix of the rows of V (float64); inf when singular or nonfinite."""
+    V = np.asarray(V, dtype=np.float64)
+    if not np.all(np.isfinite(V)):
+        return math.inf
+    w = np.linalg.eigvalsh(V @ V.T)
+    return math.inf if w.min() <= 0 else float(w.max() / w.min())
+
+
+class CaptureEdit(BaseModel):
+    mode: Literal["steer", "ablate", "swap_delta", "patch"]
+    layer: int
+    positions: list[int]
+    alpha: float = 1.0
+    token_id: int | None = None
+    target_id: int | None = None
+    ablate_token_ids: list[int] | None = None
+    target_norms: list[float] | None = None
+    norm_floor_rel: float = 1e-3
+    vectors_b64: str | None = None
+    vectors_dtype: Literal["bfloat16", "float16", "float32"] | None = None
+
+
+class CaptureRequest(BaseModel):
+    input_ids: list[int]
+    readout_positions: list[int]
+    capture_layers: list[int] | None = None
+    request_token_ids: list[int] = Field(default_factory=list)
+    top_k: int = 1000
+    edits: list[CaptureEdit] | None = None
+
+
+class LensVectorsRequest(BaseModel):
+    layers: list[int]
+    token_ids: list[int]
+
+
+def _strictly_increasing(xs: list[int]) -> bool:
+    return all(b > a for a, b in zip(xs, xs[1:]))
+
+
+def is_zero_dose(e: CaptureEdit) -> bool:
+    return e.mode != "patch" and e.target_norms is None and e.alpha == 0.0
+
+
+def validate(req: CaptureRequest, *, n_layers: int, d_model: int, vocab_rows: int,
+             fitted: set[int]) -> None:
+    """Reject a malformed request with HTTP 400 (413 when overlength)."""
+    n = len(req.input_ids)
+    if n == 0:
+        raise HTTPException(400, "input_ids is empty")
+    if n > MAX_CAPTURE_TOKENS:
+        raise HTTPException(413, f"overlength: {n} > {MAX_CAPTURE_TOKENS} tokens (rejected, never truncated)")
+    if any(t < 0 or t >= vocab_rows for t in req.input_ids):
+        raise HTTPException(400, f"input_ids outside [0, {vocab_rows})")
+    rp = req.readout_positions
+    if not rp or not _strictly_increasing(rp) or rp[0] < 0 or rp[-1] >= n:
+        raise HTTPException(400, f"readout_positions must be non-empty, strictly increasing, within [0, {n})")
+    if req.capture_layers is not None:
+        cl = req.capture_layers
+        if not cl or not _strictly_increasing(cl) or cl[0] < 0 or cl[-1] >= n_layers:
+            raise HTTPException(400, f"capture_layers must be non-empty, strictly increasing, within [0, {n_layers})")
+    if any(t < 0 or t >= vocab_rows for t in req.request_token_ids):
+        raise HTTPException(400, "request_token_ids outside the vocabulary")
+    if not 1 <= req.top_k <= MAX_TOP_K:
+        raise HTTPException(400, f"top_k must be within [1, {MAX_TOP_K}]")
+    for i, e in enumerate(req.edits or []):
+        where = f"edits[{i}]"
+        if not 0 <= e.layer < n_layers:
+            raise HTTPException(400, f"{where}: layer {e.layer} outside [0, {n_layers})")
+        p = e.positions
+        if not p or not _strictly_increasing(p) or p[0] < 0 or p[-1] >= n:
+            raise HTTPException(400, f"{where}: positions must be non-empty, strictly increasing, within [0, {n})")
+        if not math.isfinite(e.alpha):
+            raise HTTPException(400, f"{where}: alpha is not finite")
+        if e.mode != "patch" and e.layer not in fitted and e.layer != n_layers - 1:
+            raise HTTPException(400, f"{where}: layer {e.layer} has no fitted Jacobian")
+        ids: list[int] = []
+        if e.mode == "steer":
+            if e.token_id is None:
+                raise HTTPException(400, f"{where}: steer requires token_id")
+            ids = [e.token_id]
+        elif e.mode == "swap_delta":
+            if e.token_id is None or e.target_id is None or e.token_id == e.target_id:
+                raise HTTPException(400, f"{where}: swap_delta requires distinct token_id and target_id")
+            ids = [e.token_id, e.target_id]
+        elif e.mode == "ablate":
+            if not e.ablate_token_ids or len(set(e.ablate_token_ids)) != len(e.ablate_token_ids):
+                raise HTTPException(400, f"{where}: ablate requires distinct ablate_token_ids")
+            ids = list(e.ablate_token_ids)
+        else:
+            if e.alpha != 1.0 or e.target_norms is not None:
+                raise HTTPException(400, f"{where}: patch replaces rows and takes no alpha or target_norms")
+            if e.vectors_b64 is None or e.vectors_dtype is None:
+                raise HTTPException(400, f"{where}: patch requires vectors_b64 and vectors_dtype")
+            want = len(p) * d_model * _ITEMSIZE[e.vectors_dtype]
+            got = len(base64.b64decode(e.vectors_b64))
+            if got != want:
+                raise HTTPException(400, f"{where}: patch vectors are {got} bytes, expected {want}")
+        if any(t < 0 or t >= vocab_rows for t in ids):
+            raise HTTPException(400, f"{where}: token ids outside the vocabulary")
+        if e.target_norms is not None:
+            if e.mode not in ("steer", "swap_delta"):
+                raise HTTPException(400, f"{where}: target_norms applies to steer and swap_delta only")
+            if e.alpha != 1.0:
+                raise HTTPException(400, f"{where}: target_norms sets the dose; alpha must stay 1 "
+                                         "(a zero dose is alpha 0 without target_norms)")
+            if len(e.target_norms) != len(p) or not all(math.isfinite(x) and x >= 0 for x in e.target_norms):
+                raise HTTPException(400, f"{where}: target_norms must be finite, >= 0, one per position")
+        if not (math.isfinite(e.norm_floor_rel) and e.norm_floor_rel >= 0):
+            raise HTTPException(400, f"{where}: norm_floor_rel must be finite and >= 0")
+
+
+def _edit_fn(e: CaptureEdit, payload, rec: dict, hidden_dtype):
+    """The LayerEdit function for one edit: [n, D] float32 rows -> [n, D] float32."""
+    from jlens_qwen.interventions import patch_swap_rows
+
+    mode, lam = e.mode, float(e.alpha)
+    zero = is_zero_dose(e)
+    tn = mx.array(e.target_norms, dtype=mx.float32) if e.target_norms is not None else None
+    floor = float(e.norm_floor_rel)
+
+    def fn(h: mx.array) -> mx.array:
+        rec["_calls"] = rec.get("_calls", 0) + 1
+        rec["_h_norm"] = mx.linalg.norm(h, axis=-1)
+        rec["_neg_zero"] = mx.sum(mx.logical_and(h == 0, mx.view(h, mx.uint32) != 0))
+        if zero:
+            out = h
+        elif mode == "patch":
+            out = payload
+        else:
+            if mode == "steer":
+                d = mx.broadcast_to(payload, h.shape)
+            elif mode == "ablate":
+                V, G = payload
+                d = -mx.matmul(mx.matmul(G, mx.matmul(V, h.T)).T, V)
+            else:
+                V, inv = payload
+                d = patch_swap_rows(h, V, inv, 1.0) - h
+            raw = mx.linalg.norm(d, axis=-1)
+            rec["_raw"] = raw
+            if tn is None:
+                out = h + lam * d
+            else:
+                ok = raw >= floor * rec["_h_norm"]
+                scale = mx.where(ok, tn / mx.maximum(raw, 1e-30), 0.0)
+                out = mx.where(ok[:, None], h + scale[:, None] * d, h)
+                rec["_ok"] = ok
+        rec["_written"] = mx.linalg.norm(out.astype(hidden_dtype).astype(mx.float32) - h, axis=-1)
+        return out
+
+    return fn
+
+
+def _compile(S, req: CaptureRequest, records: list[dict], hidden_dtype) -> list:
+    from jlens_qwen.interventions import gram_inv, j_lens_vectors_lite, make_swap_basis
+    from jlens_qwen.model import LayerEdit
+
+    d_model = S._model.d_model
+    edits = []
+    for i, e in enumerate(req.edits or []):
+        rec = {"index": i, "mode": e.mode, "layer": e.layer, "positions": list(e.positions), "alpha": e.alpha,
+               "zero_dose": is_zero_dose(e), "requested_norm": e.target_norms, "basis_condition": None}
+        records.append(rec)
+        payload = None
+        if rec["zero_dose"]:
+            pass  # exact identity: no vector or delta is evaluated
+        elif e.mode == "steer":
+            v = j_lens_vectors_lite(S._lens, S._model, e.layer, [e.token_id])[0]
+            mx.eval(v)
+            vn = float(mx.linalg.norm(v).item())
+            if not math.isfinite(vn) or vn == 0.0:
+                raise HTTPException(422, f"edits[{i}]: steer vector is zero or nonfinite")
+            rec["v_norm"] = vn
+            payload = v
+        elif e.mode in ("ablate", "swap_delta"):
+            ids = list(e.ablate_token_ids) if e.mode == "ablate" else [e.token_id, e.target_id]
+            V = j_lens_vectors_lite(S._lens, S._model, e.layer, ids)
+            mx.eval(V)
+            cond = basis_condition(np.array(V))
+            rec["basis_condition"] = cond if math.isfinite(cond) else "inf"
+            if not cond <= COND_MAX:
+                raise HTTPException(422, f"edits[{i}]: {e.mode} basis is ill-conditioned or nonfinite "
+                                         f"(condition number {cond:.3g} > {COND_MAX:g}); not regularised")
+            if e.mode == "ablate":
+                G = gram_inv(V)
+                mx.eval(G)
+                payload = (V, G)
+            else:
+                Vs, inv = make_swap_basis(V[0], V[1])
+                mx.eval(Vs, inv)
+                payload = (Vs, inv)
+        else:
+            rows = from_bytes(base64.b64decode(e.vectors_b64), e.vectors_dtype,
+                              (len(e.positions), d_model)).astype(mx.float32)
+            mx.eval(rows)
+            if not bool(mx.all(mx.isfinite(rows)).item()):
+                raise HTTPException(422, f"edits[{i}]: patch vectors are not finite")
+            payload = rows
+        edits.append(LayerEdit(layer=e.layer, fn=_edit_fn(e, payload, rec, hidden_dtype),
+                               positions=tuple(e.positions), label=f"capture[{i}] {e.mode}"))
+    return edits
+
+
+def _get_hidden_dtype(S):
+    global _hidden_dtype
+    if _hidden_dtype is None:
+        h = S._model._text_module.embed_tokens(mx.array([[0]]))
+        mx.eval(h)
+        _hidden_dtype = h.dtype
+    return _hidden_dtype
+
+
+def _run(S, req: CaptureRequest) -> dict:
+    from jlens_qwen import patch_gdn
+
+    t0 = time.perf_counter()
+    model = S._model
+    hidden_dtype = _get_hidden_dtype(S)
+    layers = req.capture_layers if req.capture_layers is not None else list(range(model.n_layers))
+    session = model.make_stream(capture_layers=layers)
+    records: list[dict] = []
+    if req.edits is not None:
+        session.set_edits(_compile(S, req, records, hidden_dtype))
+    t1 = time.perf_counter()
+    logits, acts = session.extend(list(req.input_ids))
+    t2 = time.perf_counter()
+
+    bad = sorted({dtype_name(acts[l].dtype) for l in layers} - {dtype_name(hidden_dtype)})
+    if bad:
+        raise HTTPException(500, f"residual dtype {bad} differs from the stream dtype {dtype_name(hidden_dtype)}")
+    pos = mx.array(req.readout_positions)
+    stack = mx.stack([acts[l][0, pos] for l in layers])  # [L, P, D], native dtype
+    lf = logits.astype(mx.float32)
+    lse = mx.logsumexp(lf)
+    finite_rows = mx.all(mx.isfinite(stack.astype(mx.float32)), axis=(1, 2))
+    lazy = [stack, lse, finite_rows]
+    for rec in records:
+        lazy.extend(v for k, v in rec.items() if k.startswith("_") and isinstance(v, mx.array))
+    mx.eval(*lazy)
+    nonfinite_layers = [layers[i] for i, ok in enumerate(np.array(finite_rows).tolist()) if not ok]
+    lf_np = np.array(lf)
+    if nonfinite_layers or not np.all(np.isfinite(lf_np)):
+        raise HTTPException(422, f"nonfinite output: residual layers {nonfinite_layers}, "
+                                 f"final logits finite={bool(np.all(np.isfinite(lf_np)))}")
+
+    edit_log = []
+    for rec in records:
+        if rec.get("_calls", 0) != 1:
+            raise HTTPException(500, f"edit {rec['index']} ran {rec.get('_calls', 0)} times, expected once")
+        out = {k: v for k, v in rec.items() if not k.startswith("_")}
+        out["h_norm"] = np.array(rec["_h_norm"]).tolist()
+        out["written_delta_norm"] = np.array(rec["_written"]).tolist()
+        out["raw_delta_norm"] = np.array(rec["_raw"]).tolist() if "_raw" in rec else None
+        out["undefined"] = (~np.array(rec["_ok"])).tolist() if "_ok" in rec else None
+        out["neg_zero_inputs"] = int(rec["_neg_zero"].item())
+        edit_log.append(out)
+
+    order, ranks = ranks_of(lf_np, list(req.request_token_ids))
+    top = order[: req.top_k]
+    res_bytes = to_bytes(stack)
+    logit_bytes = to_bytes(logits)
+    t3 = time.perf_counter()
+    return {
+        "patch_id": PATCH_ID,
+        "startup_identity_sha256": _MANIFEST.get("identity_sha256"),
+        "gdn_inference_kernel": bool(patch_gdn._INFERENCE_KERNEL),
+        "n_tokens": len(req.input_ids),
+        "input_ids_sha256": hashlib.sha256(np.asarray(req.input_ids, dtype=np.int64).tobytes()).hexdigest(),
+        "capture_layers": layers,
+        "readout_positions": list(req.readout_positions),
+        "edits_installed": req.edits is not None,
+        "residuals": {"dtype": dtype_name(stack.dtype), "shape": list(stack.shape),
+                      "b64": base64.b64encode(res_bytes).decode("ascii"),
+                      "sha256": hashlib.sha256(res_bytes).hexdigest()},
+        "final_logits": {"dtype": dtype_name(logits.dtype), "n": int(logits.shape[0]),
+                         "sha256": hashlib.sha256(logit_bytes).hexdigest()},
+        "logsumexp": float(lse.item()),
+        "requested": [{"id": int(t), "logit": float(lf_np[t]), "rank": r}
+                      for t, r in zip(req.request_token_ids, ranks)],
+        "rank_ties": "ascending token id",
+        "top_ids": top.tolist(),
+        "top_logits": lf_np[top].tolist(),
+        "edit_log": edit_log,
+        "timing_s": {"compile": t1 - t0, "extend": t2 - t1, "readout": t3 - t2, "total": t3 - t0},
+    }
+
+
+def _git(repo: Path, *args: str) -> bytes:
+    return subprocess.run(["git", "-C", str(repo), *args], capture_output=True, timeout=60).stdout
+
+
+def _tree_digest(root: Path, suffixes: tuple[str, ...]) -> str:
+    h = hashlib.sha256()
+    for p in sorted(root.rglob("*")):
+        if p.is_file() and p.suffix in suffixes and "__pycache__" not in p.parts:
+            h.update(str(p.relative_to(root)).encode())
+            h.update(sha256_file(p).encode())
+    return h.hexdigest()
+
+
+def _build_manifest(S) -> None:
+    import mlx_lm
+    from huggingface_hub import snapshot_download
+
+    from jlens_qwen import custom_gdn_patch, patch_gdn
+
+    t0 = time.time()
+    snapshot = Path(snapshot_download(S._model_id, local_files_only=True))
+    lens_path = S.resolve_lens_path(os.environ.get("JLENS_PATH"), str(S._repo_root / "data" / "lens"))
+    repo = S._repo_root
+    untracked = [x for x in _git(repo, "ls-files", "--others", "--exclude-standard").decode().splitlines()
+                 if x.endswith(".py")]
+    now_sources = _loaded_jlens_sources()
+    changed = sorted(k for k in IMPORT_SOURCES if now_sources.get(k) != IMPORT_SOURCES[k])
+    mlx_pkg = Path(mx.__file__).parent
+    try:
+        device = mx.metal.device_info()
+        device = {k: (v if isinstance(v, (int, float, str, bool)) else str(v)) for k, v in sorted(device.items())}
+    except Exception as exc:
+        device = f"unresolved: {exc!r}"
+    hw_model = subprocess.run(["sysctl", "-n", "hw.model"], capture_output=True, text=True).stdout.strip()
+    lens = S._lens
+    identity = {
+        "patch_id": PATCH_ID, "cond_max": COND_MAX, "max_capture_tokens": MAX_CAPTURE_TOKENS,
+        "model_id": S._model_id,
+        "model_files_sha256": {p.name: sha256_file(p) for p in sorted(snapshot.iterdir()) if p.is_file()},
+        "lens_sha256": sha256_file(lens_path) if lens_path else None,
+        "lens_n_prompts": lens.n_prompts if lens is not None else None,
+        "lens_source_layers": list(lens.source_layers) if lens is not None else [],
+        "n_layers": S._model.n_layers, "d_model": S._model.d_model,
+        "vocab_rows": int(S._model._lm_head.weight.shape[0]), "hidden_dtype": dtype_name(_get_hidden_dtype(S)),
+        "loaded_sources_sha256": IMPORT_SOURCES,
+        "upstream_head": _git(repo, "rev-parse", "HEAD").decode().strip(),
+        "upstream_tracked_diff_sha256": hashlib.sha256(_git(repo, "diff", "HEAD")).hexdigest(),
+        "upstream_untracked_sources_sha256": {x: sha256_file(repo / x) for x in sorted(untracked)},
+        "mlx": mx.__version__, "mlx_binaries_sha256": _tree_digest(mlx_pkg, (".so", ".dylib", ".metallib")),
+        "mlx_lm": mlx_lm.__version__, "mlx_lm_sources_sha256": _tree_digest(Path(mlx_lm.__file__).parent, (".py",)),
+        "numpy": np.__version__, "python": sys.version.split()[0],
+        "macos": platform.mac_ver()[0], "machine": platform.machine(), "hw_model": hw_model, "metal_device": device,
+        "gdn_dispatch_at_startup": {"patch_gdn": bool(patch_gdn._PATCHED),
+                                    "checkpoint": bool(patch_gdn._CHECKPOINT_APPLIED),
+                                    "inference_kernel": bool(patch_gdn._INFERENCE_KERNEL),
+                                    "custom_vjp": bool(custom_gdn_patch._PATCHED_CUSTOM)},
+    }
+    ident_json = json.dumps(identity, sort_keys=True)
+    _MANIFEST.update({
+        "ready": not changed,
+        "refusal": f"loaded sources changed on disk after import: {changed}; restart the server" if changed else None,
+        "identity": identity,
+        "identity_sha256": hashlib.sha256(ident_json.encode()).hexdigest(),
+        "metadata": {"model_snapshot": str(snapshot), "lens_path": lens_path, "upstream_repo": str(repo),
+                     "started_at": time.strftime("%Y-%m-%dT%H:%M:%S"), "pid": os.getpid(),
+                     "manifest_seconds": round(time.time() - t0, 1)},
+    })
+    runs = S._repo_root.parent.parent / "runs"
+    if runs.is_dir():
+        (runs / f"capture_startup_{time.strftime('%Y%m%dT%H%M%S')}.json").write_text(
+            json.dumps({k: v for k, v in _MANIFEST.items()}, indent=1))
+    print(f"CAPTURE: startup manifest {_MANIFEST['identity_sha256'][:12]} ready={_MANIFEST['ready']} "
+          f"({_MANIFEST['metadata']['manifest_seconds']} s)", flush=True)
+
+
+@router.on_event("startup")
+async def _startup_manifest():
+    S = _server()
+    if S._model is None:
+        return
+    await asyncio.to_thread(_build_manifest, S)
+
+
+def _require_ready():
+    if not _MANIFEST.get("ready"):
+        raise HTTPException(503, _MANIFEST.get("refusal") or "startup manifest not ready")
+
+
+@router.get("/api/capture/info")
+async def capture_info():
+    S = _server()
+    if S._model is None or "identity" not in _MANIFEST:
+        raise HTTPException(503, "model or startup manifest not ready")
+    ident, meta = _MANIFEST["identity"], _MANIFEST["metadata"]
+    return {"patch_id": PATCH_ID, "ready": _MANIFEST["ready"], "refusal": _MANIFEST["refusal"],
+            "identity": ident, "identity_sha256": _MANIFEST["identity_sha256"], "metadata": meta,
+            "model_snapshot": meta["model_snapshot"], "lens_path": meta["lens_path"],
+            "n_layers": ident["n_layers"], "d_model": ident["d_model"], "vocab_rows": ident["vocab_rows"],
+            "hidden_dtype": ident["hidden_dtype"], "max_capture_tokens": MAX_CAPTURE_TOKENS}
+
+
+@router.post("/api/capture")
+async def capture(req: CaptureRequest):
+    S = _server()
+    S._require_active_mode()
+    if S._model is None:
+        raise HTTPException(503, "model not loaded")
+    _require_ready()
+    fitted = set(S._lens.source_layers) if S._lens is not None else set()
+    validate(req, n_layers=S._model.n_layers, d_model=S._model.d_model,
+             vocab_rows=int(S._model._lm_head.weight.shape[0]), fitted=fitted)
+    async with S._gpu_lock:
+        return await asyncio.to_thread(_run, S, req)
+
+
+@router.post("/api/capture/lens_vectors")
+async def lens_vectors(req: LensVectorsRequest):
+    """v_t = J_lᵀ W_U[t] (layer n_layers-1: W_U[t]) as float32 bytes [L, T, D] (§6.2 R2); fp16 matmul inside."""
+    from jlens_qwen.interventions import j_lens_vectors_lite
+
+    S = _server()
+    if S._model is None:
+        raise HTTPException(503, "model not loaded")
+    _require_ready()
+    n_layers, vocab_rows = S._model.n_layers, int(S._model._lm_head.weight.shape[0])
+    fitted = set(S._lens.source_layers) if S._lens is not None else set()
+    if not req.layers or not req.token_ids or len(req.layers) * len(req.token_ids) > MAX_LENS_VECTORS:
+        raise HTTPException(400, f"layers x token_ids must be non-empty and at most {MAX_LENS_VECTORS}")
+    if any(l not in fitted and l != n_layers - 1 for l in req.layers):
+        raise HTTPException(400, "a requested layer has no fitted Jacobian")
+    if any(t < 0 or t >= vocab_rows for t in req.token_ids):
+        raise HTTPException(400, "token_ids outside the vocabulary")
+
+    def _vectors():
+        out = mx.stack([j_lens_vectors_lite(S._lens, S._model, l, list(req.token_ids))
+                        for l in req.layers]).astype(mx.float32)
+        mx.eval(out)
+        if not bool(mx.all(mx.isfinite(out)).item()):
+            raise HTTPException(422, "nonfinite lens vectors")
+        return to_bytes(out)
+
+    async with S._gpu_lock:
+        buf = await asyncio.to_thread(_vectors)
+    return {"dtype": "float32", "shape": [len(req.layers), len(req.token_ids), S._model.d_model],
+            "b64": base64.b64encode(buf).decode("ascii"),
+            "sha256": hashlib.sha256(buf).hexdigest(),
+            "startup_identity_sha256": _MANIFEST.get("identity_sha256")}
