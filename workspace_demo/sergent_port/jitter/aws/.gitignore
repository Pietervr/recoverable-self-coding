# the run-instances request bodies and probe files. s4_aws.json, s4_instances.json and s4_spend.json ARE committed.
bundle/*.tar.gz
userdata_s2closure_*.sh
userdata_s4a_*.sh
userdata_s4b_*.sh
run_*.json
probe.txt*
userdata_probe_*.sh
userdata_xprobe_*.sh
userdata_cprobe_*.sh
userdata_cpair_*.sh
